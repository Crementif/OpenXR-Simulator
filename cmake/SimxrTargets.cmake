function(simxr_configure_target target)
    target_compile_features(${target} PRIVATE cxx_std_20)
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
    target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src" "${PROJECT_BINARY_DIR}/generated")
    target_link_libraries(${target} PRIVATE simxr_openxr_headers)
    if(SIMXR_ENABLE_PCH)
        target_precompile_headers(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/Pch.h")
    endif()
    if(WIN32)
        target_compile_definitions(${target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX
            _CRT_SECURE_NO_WARNINGS UNICODE _UNICODE)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8 /W4)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wno-missing-field-initializers)
    endif()
    if(SIMXR_SANITIZER)
        if(MSVC)
            message(FATAL_ERROR "Sanitizer presets require GCC or Clang")
        elseif(SIMXR_SANITIZER STREQUAL "address")
            set(sanitizer_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
        elseif(SIMXR_SANITIZER STREQUAL "thread")
            set(sanitizer_flags -fsanitize=thread -fno-omit-frame-pointer)
        else()
            message(FATAL_ERROR "Unknown SIMXR_SANITIZER: ${SIMXR_SANITIZER}")
        endif()
        target_compile_options(${target} PRIVATE ${sanitizer_flags})
        target_link_options(${target} PRIVATE ${sanitizer_flags})
    endif()
endfunction()

function(simxr_set_output_directory target)
    set_target_properties(${target} PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY "${SIMXR_OUTPUT_DIRECTORY}"
        LIBRARY_OUTPUT_DIRECTORY "${SIMXR_OUTPUT_DIRECTORY}"
        ARCHIVE_OUTPUT_DIRECTORY "${SIMXR_OUTPUT_DIRECTORY}")
    foreach(output_config IN LISTS CMAKE_CONFIGURATION_TYPES)
        string(TOUPPER "${output_config}" output_config)
        set_target_properties(${target} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY_${output_config} "${SIMXR_OUTPUT_DIRECTORY}"
            LIBRARY_OUTPUT_DIRECTORY_${output_config} "${SIMXR_OUTPUT_DIRECTORY}"
            ARCHIVE_OUTPUT_DIRECTORY_${output_config} "${SIMXR_OUTPUT_DIRECTORY}")
    endforeach()
endfunction()

function(simxr_add_test target source test_name)
    add_executable(${target} ${source})
    simxr_configure_target(${target})
    if(MSVC)
        target_compile_options(${target} PRIVATE /UNDEBUG)
    else()
        target_compile_options(${target} PRIVATE -UNDEBUG)
    endif()
    add_test(NAME ${test_name} COMMAND ${target})
    set_tests_properties(${test_name} PROPERTIES TIMEOUT 30)
endfunction()
