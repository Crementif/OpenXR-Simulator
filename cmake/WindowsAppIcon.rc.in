#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/resources/branding/openxr-simulator.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenXR Simulator contributors"
            VALUE "FileDescription", "OpenXR Simulator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "simxr_companion"
            VALUE "OriginalFilename", "simxr_companion.exe"
            VALUE "ProductName", "OpenXR Simulator"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
