configure_file(cmake/PackageReadme.txt.in "${PROJECT_BINARY_DIR}/PACKAGE-README.txt" @ONLY)
install(FILES "${PROJECT_BINARY_DIR}/PACKAGE-README.txt" DESTINATION . RENAME README.txt)
# Archives are relocatable: the runtime manifest resolves its adjacent library.
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION share/licenses/simxr)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/sdk/python/" DESTINATION share/simxr/sdk/python
    FILES_MATCHING PATTERN "*.py" PATTERN "pyproject.toml"
    PATTERN "__pycache__" EXCLUDE PATTERN "*.egg-info" EXCLUDE)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/examples/" DESTINATION share/simxr/examples
    FILES_MATCHING PATTERN "*.py" PATTERN "*.luau")
install(FILES "${PROJECT_SOURCE_DIR}/docs/BUILDING.md" "${PROJECT_SOURCE_DIR}/docs/AUTOMATION.md"
    "${PROJECT_SOURCE_DIR}/docs/CONTROL_PROTOCOL.md" DESTINATION share/doc/simxr)
if(UNIX)
    install(PROGRAMS "${PROJECT_SOURCE_DIR}/scripts/launch-linux.py" DESTINATION bin)
endif()
foreach(probe xr_probe_linux xr_probe_d3d11 xr_probe_d3d12 xr_probe_opengl xr_probe_vk)
    if(TARGET ${probe})
        install(TARGETS ${probe} RUNTIME DESTINATION bin)
    endif()
endforeach()
if(MINGW)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=libstdc++.dll.a
        OUTPUT_VARIABLE simxr_cpp_import OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    get_filename_component(simxr_cpp_library_dir "${simxr_cpp_import}" DIRECTORY)
    get_filename_component(simxr_toolchain_bin "${simxr_cpp_library_dir}/../bin" ABSOLUTE)
    find_file(SIMXR_MINGW_CPP_DLL NAMES libstdc++-6.dll HINTS "${simxr_toolchain_bin}" REQUIRED)
    find_file(SIMXR_MINGW_GCC_DLL NAMES libgcc_s_seh-1.dll libgcc_s_dw2-1.dll libgcc_s_sjlj-1.dll
        HINTS "${simxr_toolchain_bin}" REQUIRED)
    find_file(SIMXR_MINGW_THREAD_DLL NAMES libwinpthread-1.dll HINTS "${simxr_toolchain_bin}" REQUIRED)
    install(FILES "${SIMXR_MINGW_CPP_DLL}" "${SIMXR_MINGW_GCC_DLL}" "${SIMXR_MINGW_THREAD_DLL}" DESTINATION bin)
    set(SIMXR_TOOLCHAIN_LICENSE_DIR "" CACHE PATH "MinGW redistributable license directory for binary packages")
    if(SIMXR_TOOLCHAIN_LICENSE_DIR)
        install(DIRECTORY "${SIMXR_TOOLCHAIN_LICENSE_DIR}/" DESTINATION share/licenses/toolchain)
    else()
        install(CODE "message(FATAL_ERROR \"Set SIMXR_TOOLCHAIN_LICENSE_DIR before installing MinGW redistributables\")")
    endif()
elseif(MSVC)
    include(InstallRequiredSystemLibraries)
endif()
if(WIN32 AND (TARGET xr_probe_d3d11 OR TARGET xr_probe_vk))
    get_target_property(simxr_openxr_loader_type ${SIMXR_OPENXR_LOADER_TARGET} TYPE)
    if(simxr_openxr_loader_type STREQUAL "SHARED_LIBRARY")
        install(IMPORTED_RUNTIME_ARTIFACTS ${SIMXR_OPENXR_LOADER_TARGET} RUNTIME DESTINATION bin)
    elseif(simxr_openxr_loader_type STREQUAL "UNKNOWN_LIBRARY")
        get_filename_component(simxr_openxr_library_dir "${SIMXR_OPENXR_LOADER}" DIRECTORY)
        find_file(SIMXR_OPENXR_LOADER_DLL NAMES openxr_loader.dll libopenxr_loader.dll
            HINTS "${simxr_openxr_library_dir}" "${simxr_openxr_library_dir}/../bin" REQUIRED)
        install(FILES "${SIMXR_OPENXR_LOADER_DLL}" DESTINATION bin)
    endif()
    set(SIMXR_OPENXR_LOADER_LICENSE_FILE "" CACHE FILEPATH "License for the packaged OpenXR loader")
    if(SIMXR_OPENXR_LOADER_LICENSE_FILE)
        install(FILES "${SIMXR_OPENXR_LOADER_LICENSE_FILE}" DESTINATION share/licenses/openxr)
    else()
        install(CODE "message(FATAL_ERROR \"Set SIMXR_OPENXR_LOADER_LICENSE_FILE before installing loader probes\")")
    endif()
endif()
if(CMAKE_VS_PLATFORM_NAME)
    set(simxr_package_arch "${CMAKE_VS_PLATFORM_NAME}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(simxr_package_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
elseif(MSVC_CXX_ARCHITECTURE_ID)
    set(simxr_package_arch "${MSVC_CXX_ARCHITECTURE_ID}")
else()
    set(simxr_package_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
string(TOLOWER "${simxr_package_arch}" simxr_package_arch)
if(simxr_package_arch MATCHES "^(amd64|x64|x86_64)$")
    set(simxr_package_arch "x86_64")
elseif(simxr_package_arch MATCHES "^(win32|x86|i[3-6]86)$")
    set(simxr_package_arch "x86")
elseif(simxr_package_arch MATCHES "^(aarch64|arm64)$")
    set(simxr_package_arch "arm64")
endif()
if(NOT simxr_package_arch)
    math(EXPR simxr_package_bits "${CMAKE_SIZEOF_VOID_P} * 8")
    set(simxr_package_arch "${simxr_package_bits}bit")
endif()
set(CPACK_PACKAGE_NAME "openxr-simulator")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_VENDOR "OpenXR Simulator contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Headset-free OpenXR development runtime and companion")
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${simxr_package_arch}")
set(CPACK_GENERATOR "TGZ")
if(WIN32)
    set(CPACK_GENERATOR "ZIP")
endif()
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
include(CPack)
