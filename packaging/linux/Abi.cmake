# ELF requirements for the Ubuntu 24.04 x64 baseline, which also covers Fedora 40 and newer.
include_guard(GLOBAL)

set(SIMXR_ABI_LIMITS GLIBC 2.39 GLIBCXX 3.4.33 CXXABI 1.3.15 GCC 14.0.0)
set(SIMXR_ABI_SPECIAL_VERSIONS GLIBC_ABI_DT_RELR CXXABI_FLOAT128 CXXABI_TM_1 GLIBCXX_DEBUG_MESSAGE_LENGTH)
set(SIMXR_ABI_SYSTEM_LIBRARIES
    libc.so.6 libm.so.6 libstdc++.so.6 libgcc_s.so.1 libdl.so.2 libpthread.so.0 librt.so.1
    ld-linux-x86-64.so.2 libvulkan.so.1 libopenxr_loader.so.1)

# Sets out to an error for symbol versions newer than the baseline, or to an empty string.
function(simxr_abi_version_error out text label require_needs)
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(in_needs FALSE)
    set(found_needs FALSE)
    foreach(line IN LISTS lines)
        if(line MATCHES "^Version needs section ")
            set(in_needs TRUE)
            set(found_needs TRUE)
            continue()
        elseif(line MATCHES "^Version [a-z]+ section ")
            set(in_needs FALSE)
        endif()
        if(NOT in_needs OR NOT line MATCHES "Name:[ \t]+([^ \t]+)")
            continue()
        endif()
        set(name "${CMAKE_MATCH_1}")
        if(name IN_LIST SIMXR_ABI_SPECIAL_VERSIONS)
            continue()
        endif()
        if(NOT name MATCHES "^(GLIBC|GLIBCXX|CXXABI|GCC)_([0-9]+(\\.[0-9]+)*)$")
            set(${out} "${label} requires unsupported symbol version ${name}" PARENT_SCOPE)
            return()
        endif()
        set(family "${CMAKE_MATCH_1}")
        set(version "${CMAKE_MATCH_2}")
        list(FIND SIMXR_ABI_LIMITS "${family}" index)
        math(EXPR index "${index} + 1")
        list(GET SIMXR_ABI_LIMITS ${index} limit)
        if(version VERSION_GREATER limit)
            set(${out} "${label} requires ${name}, newer than the Ubuntu 24.04 baseline" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    if(require_needs AND NOT found_needs)
        set(${out} "${label} has dynamic version requirements that readelf could not inspect" PARENT_SCOPE)
        return()
    endif()
    set(${out} "" PARENT_SCOPE)
endfunction()

# Sets out to an error for unexpected shared libraries or search paths, or to an empty string.
function(simxr_abi_dynamic_error out text label)
    string(REPLACE ";" "," text "${text}")
    string(REGEX MATCHALL "\\(NEEDED\\)[^\n[]*\\[[^]\n]+\\]" needed "${text}")
    foreach(entry IN LISTS needed)
        string(REGEX REPLACE ".*\\[([^]]+)\\]$" "\\1" library "${entry}")
        if(NOT library IN_LIST SIMXR_ABI_SYSTEM_LIBRARIES)
            set(${out} "${label} requires an unqualified shared library: ${library}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    string(REGEX MATCHALL "\\(R(UN)?PATH\\)[^\n[]*\\[[^]\n]*\\]" paths "${text}")
    foreach(entry IN LISTS paths)
        string(REGEX REPLACE ".*\\[([^]]*)\\]$" "\\1" search "${entry}")
        string(REPLACE ":" ";" search "${search}")
        foreach(directory IN LISTS search)
            if(NOT directory STREQUAL [=[$ORIGIN]=] AND NOT directory STREQUAL [=[${ORIGIN}]=])
                set(${out} "${label} contains an unsupported runtime library search path: ${directory}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endforeach()
    set(${out} "" PARENT_SCOPE)
endfunction()

function(simxr_abi_check_elf path)
    file(READ "${path}" header LIMIT 20 HEX)
    if(NOT header MATCHES "^7f454c460201" OR NOT header MATCHES "3e00$")
        message(FATAL_ERROR "Expected a Linux x64 ELF binary: ${path}")
    endif()
    find_program(SIMXR_READELF readelf REQUIRED)
    foreach(mode version-info dynamic)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${SIMXR_READELF}" --wide --${mode} "${path}"
            OUTPUT_VARIABLE ${mode} RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot inspect ELF requirements for ${path}")
        endif()
    endforeach()
    set(require_needs FALSE)
    if(dynamic MATCHES "\\(VERNEED(NUM)?\\)")
        set(require_needs TRUE)
    endif()
    simxr_abi_version_error(error "${version-info}" "${path}" ${require_needs})
    if(NOT error)
        simxr_abi_dynamic_error(error "${dynamic}" "${path}")
    endif()
    if(error)
        message(FATAL_ERROR "${error}")
    endif()
endfunction()
