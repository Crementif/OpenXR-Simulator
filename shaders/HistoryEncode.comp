#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2DArray sourceImage;
layout(std430,binding=1) buffer Pixels { uint pixels[]; };
layout(push_constant) uniform Shape { uint width; uint height; uint layers; uint eyeWidth; uint codedHeight; uint srgb; } shape;
vec3 color(uint x, uint y)
{
    uint layer=x/shape.eyeWidth;
    x%=shape.eyeWidth;
    if(x>=shape.width || y>=shape.height || layer>=shape.layers) return vec3(0);
    vec3 c=clamp(texelFetch(sourceImage,ivec3(x,y,layer),0).rgb,0,1);
    if(shape.srgb!=0) c=mix(12.92*c,1.055*pow(c,vec3(1.0/2.4))-0.055,greaterThan(c,vec3(0.0031308)));
    return c;
}
uint byteValue(float v) { return uint(round(clamp(v,0,1)*255)); }
void main()
{
    uint x=gl_GlobalInvocationID.x*4, y=gl_GlobalInvocationID.y;
    uint stride=shape.eyeWidth*shape.layers;
    if(x>=stride || y>=shape.codedHeight) return;
    uint luma=0;
    for(uint i=0;i<4;i++) luma|=byteValue(dot(color(x+i,y),vec3(0.2126,0.7152,0.0722)))<<(i*8);
    pixels[(y*stride+x)/4]=luma;
    if((y&1)!=0) return;
    uint chroma=0;
    for(uint i=0;i<2;i++)
    {
        vec3 c=(color(x+2*i,y)+color(x+2*i+1,y)+color(x+2*i,y+1)+color(x+2*i+1,y+1))*0.25;
        uint u=byteValue(dot(c,vec3(-0.114572,-0.385428,0.5))+0.5);
        uint v=byteValue(dot(c,vec3(0.5,-0.454153,-0.045847))+0.5);
        chroma|=(u|(v<<8))<<(i*16);
    }
    pixels[(stride*shape.codedHeight+(y/2)*stride+x)/4]=chroma;
}
